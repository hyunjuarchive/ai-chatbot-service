# ===========================================================
#  환경 변수 예시 파일
#  실제 값을 채운 뒤 이 파일을 ".env" 로 복사해서 사용하세요.
#    cp .env.example .env   (Windows PowerShell: Copy-Item .env.example .env)
#  .env 파일은 .gitignore 에 의해 저장소에 커밋되지 않습니다.
# ===========================================================

# --- AI (Anthropic Claude API) ---
# https://console.anthropic.com 에서 발급. 비어 있으면 서버가 mock 응답으로 동작합니다.
ANTHROPIC_API_KEY=
# 서드파티 게이트웨이/프록시로 Claude 를 쓸 때만 그 base URL 을 입력.
# 공식 Anthropic 을 직접 쓰면 비워둡니다. 예: https://api.example.com
ANTHROPIC_BASE_URL=
# 사용할 모델 ID. 저비용 대화용 기본값: claude-sonnet-5 (고성능 필요 시 claude-opus-5)
ANTHROPIC_MODEL=claude-sonnet-5
# AI 호출 타임아웃(초). 초과 시 사용자에게 오류 안내를 반환합니다.
AI_TIMEOUT_SECONDS=30
# 문맥 유지를 위해 프롬프트에 포함할 직전 대화(Q/A) 최대 개수
AI_MAX_CONTEXT_MESSAGES=10

# --- 세션/보안 ---
# 세션 쿠키 서명 키. 배포 시 반드시 긴 랜덤 문자열로 교체하세요.
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-to-a-long-random-string

# --- 데이터베이스 ---
# 기본값은 프로젝트 폴더의 SQLite 파일입니다.
DATABASE_URL=sqlite:///./chatbot.db

# --- 입력 검증 ---
# 질문 1건의 최대 글자 수
MAX_QUESTION_LENGTH=2000

# --- 관리자 계정(선택) ---
# 아래 사용자명으로 회원가입하면 자동으로 관리자 권한이 부여됩니다.
ADMIN_USERNAMES=admin
